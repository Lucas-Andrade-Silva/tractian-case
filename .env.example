# Copie para agent/.env (não commitado) e preencha.

# --- API industrial (sobe com `make up`) ------------------------------------
TRACTIAN_API_BASE_URL=http://localhost:8000
REQUEST_TIMEOUT_S=30

# --- LLM --------------------------------------------------------------------
# Provedor: groq | openai. Instale o extra correspondente:
#   uv pip install -e ".[groq]"
# O modelo precisa suportar tool calling E structured output — os papéis worker usam o
# primeiro, e Supervisor/Decisor dependem do segundo.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# 0.0 por padrão: a Parte 2 mede estabilidade entre execuções, e variação do decoder
# seria confundida com instabilidade do agente.
LLM_TEMPERATURE=0.0

# --- Juiz da avaliação (Parte 2, camada 2) ----------------------------------
# Deliberadamente de outra família que o modelo do agente: julgar a própria saída com o
# mesmo modelo introduz viés de auto-preferência (ADR 0005). Se não definido, herda a
# configuração do agente.
#
# O painel roda os juízes por OpenRouter (`python painel/julgar.py`), que dá acesso a
# modelos gratuitos — os de sufixo `:free` não consomem crédito. Chave gratuita em
# https://openrouter.ai/keys. Para ver os modelos já conhecidos:
#     python painel/julgar.py --modelos
# Trocar de modelo é trocar esta linha (ou passar `--modelo <id>` na chamada).
MAX_SUPERVISOR_TURNS=12
MAX_WORKER_STEPS=6

# --- Política de evidência do Investigador (variável de experimento) --------
# fixed       = sempre apura asset + baseline + data-quality + rms
# conditional = adapta ao tipo de pergunta (diagnóstico vs. conceitual)
# Qual rende melhor recall por token é questão empírica; troque aqui para comparar.
EVIDENCE_POLICY=fixed

# --- Chaves extras para rodízio de cota --------------------------------------
# A cota da Groq no plano gratuito é POR DIA e POR CONTA (200k tokens/dia no menor
# modelo ≈ 10 execuções da bateria inteira). Com chaves de contas diferentes, esgotar
# uma não interrompe a bateria: o cliente passa para a próxima e continua.
# Só cota diária (TPD/RPD) dispara a troca — limite por minuto reabre sozinho.
# LLM_API_KEY2=
# LLM_API_KEY3=

# --- Rótulo da bateria -------------------------------------------------------
# Gravado em cada trace (campo `fase`) e usado pelo painel para separar as baterias.
# Vazio é o normal em execução avulsa; preencha ao rodar uma bateria que você quer
# comparar depois — `make eval-politica POLITICA=conditional` já faz isso sozinho.
# RUN_PHASE=

# --- Modelo por papel (fallback: LLM_MODEL) ---------------------------------
# Papéis que chamam tools em série se beneficiam de um modelo que emita várias tool
# calls por resposta; papéis que só produzem decisão se beneficiam do mais capaz. Como
# os limites de cota da Groq são POR MODELO, distribuir papéis também distribui o
# consumo entre pools separados.
# MODEL_SUPERVISOR=qwen/qwen3.8-27b
# MODEL_INVESTIGADOR=qwen/qwen3.6-27b
# MODEL_CONTEXTUALIZADOR=qwen/qwen3.8-27b
# MODEL_DECISOR=openai/gpt-oss-120b
# MODEL_EXECUTOR=openai/gpt-oss-120b

# --- Teto de tokens de saída por papel (fallback: padrão do provedor) -------
# A Groq valida o `max_tokens` DECLARADO na requisição, antes de gerar: sem teto
# explícito o cliente envia o padrão dele e modelos com limite baixo de saída por minuto
# (qwen3.6-27b: 1.000 OTPM) recusam com 429 "Request too large" mesmo quando a resposta
# real caberia. Pedir brevidade no prompt não resolve — o prompt governa o que o modelo
# escreve, não o número que a requisição declara.
# MAX_TOKENS_SUPERVISOR=500
# MAX_TOKENS_INVESTIGADOR=700
# MAX_TOKENS_CONTEXTUALIZADOR=700
# MAX_TOKENS_DECISOR=2000
# MAX_TOKENS_EXECUTOR=2000

# --- Esforço de raciocínio por papel (fallback: padrão do modelo) ------------
# none | low | medium | high. Em modelo de raciocínio, o pensamento consome o MESMO
# orçamento de `max_tokens` que a resposta: com teto baixo, o papel é cortado antes de
# escrever o resumo e o Supervisor o reaciona, refazendo a apuração inteira. Onde o teto
# não pode subir (limite de saída por minuto do provedor), reduza o raciocínio.
# REASONING_EFFORT_SUPERVISOR=low
# REASONING_EFFORT_INVESTIGADOR=low
# REASONING_EFFORT_CONTEXTUALIZADOR=low

# --- Porta do agente/UI ------------------------------------------------------
AGENT_PORT=8001

# --- LangSmith (opcional, só observabilidade de dev — ADR 0004) --------------
# O trace da avaliação é o JSON local; o LangSmith é para inspeção humana.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tractian-agent

# --- Gerador de gabarito sintetico (aba Consulta) ---------------------------
# Consulta de texto livre nao tem gabarito humano. O GERADOR escreve a questao de
# referencia a partir da mensagem do usuario, ANTES de o agente rodar; o JUDGE julga a
# resposta contra ela. Precisam ser modelos DIFERENTES: o mesmo modelo nos dois papeis
# mede auto-consistencia, nao acuracia, e o servidor recusa a consulta se forem iguais.
GERADOR_PROVIDER=groq
GERADOR_MODEL=openai/gpt-oss-120b

# --- Juiz da camada 2 (comite de LLM) ---------------------------------------
# O juiz roda SEMPRE no OpenRouter; os papeis do agente sempre na Groq. Separa as cotas e
# garante a regra do ADR 0007: nenhum juiz coincide com o gerador do gabarito (Groq).
# Nao existe JUDGE_PROVIDER — herdar o provedor mandava a chave de um para o outro (401).
# Cole a chave do OpenRouter (sk-or-...): https://openrouter.ai/keys
JUDGE_API_KEY=

# Modelo padrao do comite. A aba Consulta troca por dimensao sem reiniciar; para fixar
# uma escolha, descomente a variavel da dimensao.
JUDGE_MODEL=minimax/minimax-m3:free
# JUDGE_MODEL_HONESTIDADE=z-ai/glm-5.2:free
# JUDGE_MODEL_CAUSA_RAIZ=nvidia/nemotron-3-super-120b-a12b:free
# JUDGE_MODEL_JUSTIFICATIVA=google/gemma-4-31b-it:free
